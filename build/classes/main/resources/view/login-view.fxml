<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.recursos.human.reclutamiento.controller.LoginController">
   <children>
      <HBox prefHeight="500.0" prefWidth="850.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <AnchorPane prefHeight="500.0" prefWidth="425.0" styleClass="form-panel" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" layoutX="140.0" layoutY="64.0" prefHeight="386.0" prefWidth="613.0" spacing="12.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="140.0" AnchorPane.rightAnchor="97.0" AnchorPane.topAnchor="64.0">
                     <children>
                        
                        <Label styleClass="subtitle-label" text="Inicia sesión para continuar" />
                        
                        <VBox alignment="TOP_LEFT" prefWidth="320.0" spacing="4.0">
                           <children>
                              <Label styleClass="field-label" text="Correo Electrónico" />
                              <TextField fx:id="txtEmail" prefHeight="38.0" prefWidth="320.0" promptText="" styleClass="text-field" />
                           </children>
                        </VBox>
                        
                        <VBox alignment="TOP_LEFT" prefWidth="320.0" spacing="4.0">
                           <children>
                              <Label styleClass="field-label" text="Contraseña" />
                              <PasswordField fx:id="txtPassword" prefHeight="38.0" prefWidth="320.0" promptText="" styleClass="password-field" />
                           </children>
                        </VBox>
                        
                        <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#handleLoginButtonAction" prefHeight="40.0" prefWidth="320.0" styleClass="btn-primary" text="Ingresar al Sistema" />
                        
                        <Button fx:id="btnGoToRegister" mnemonicParsing="false" onAction="#handleRegisterButtonAction" prefHeight="35.0" prefWidth="320.0" styleClass="btn-secondary" text="¿No tienes cuenta? Regístrate" />
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
            
         </children>
      </HBox>
   </children>
</AnchorPane>
